meta {
  name: 查询当前交易日全部成交
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/ctp/fetch_trades?mode=sandbox
  body: none
  auth: inherit
}

params:query {
  mode: sandbox
}

assert {
  res.status: eq 200
  res.body.mode: eq sandbox
}

tests {
  test("成功响应属于模拟盘，并包含 CTP 请求号与交易日", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.mode).to.equal("sandbox");
    expect(Number.isInteger(body.request_id)).to.equal(true);
    expect(body.trading_day).to.match(/^\d{8}$/);
  });

  test("trades 为数组，逐项保留详细 CTP 字段；允许空数组", function () {
    const rows = res.getBody().trades;
    expect(rows).to.be.an("array");
    rows.forEach(function (row) {
      expect(row.InstrumentID).to.be.a("string");
      expect(row.TradeID).to.be.a("string");
      expect(row.OrderSysID).to.be.a("string");
      expect(row.Direction).to.be.a("string");
      expect(row.OffsetFlag).to.be.a("string");
      expect(row).to.have.property("Price");
      if (row.Price !== null) expect(row.Price).to.be.a("number");
      expect(Number.isInteger(row.Volume), "Volume 应为整数").to.equal(true);
    });
  });
}

docs {
  默认 mode=sandbox，读取服务端 ctp.test，沿用集合 Bearer 鉴权。
  逐笔成交，不按订单聚合；下单 200 后用成交记录核实实际成交情况。
  无记录时返回空数组是合法结果。首次连接会认证、登录并确认结算。
}
