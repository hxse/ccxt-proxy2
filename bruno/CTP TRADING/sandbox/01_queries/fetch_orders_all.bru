meta {
  name: 查询当前交易日全部订单
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/ctp/fetch_orders?mode=sandbox
  body: none
  auth: inherit
}

params:query {
  mode: sandbox
}

assert {
  res.status: eq 200
  res.body.mode: eq sandbox
}

tests {
  test("成功响应属于模拟盘，并包含 CTP 请求号与交易日", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.mode).to.equal("sandbox");
    expect(Number.isInteger(body.request_id)).to.equal(true);
    expect(body.trading_day).to.match(/^\d{8}$/);
  });

  test("orders 为数组，逐项保留详细 CTP 字段；允许空数组", function () {
    const rows = res.getBody().orders;
    expect(rows).to.be.an("array");
    rows.forEach(function (row) {
      expect(row.InstrumentID).to.be.a("string");
      expect(row.OrderRef).to.be.a("string");
      expect(row.OrderSysID).to.be.a("string");
      expect(row.OrderStatus).to.be.a("string");
      expect(row.OrderSubmitStatus).to.be.a("string");
      expect(row.Direction).to.be.a("string");
      expect(row.CombOffsetFlag).to.be.a("string");
      expect(Number.isInteger(row.VolumeTotalOriginal), "VolumeTotalOriginal 应为整数").to.equal(true);
      expect(Number.isInteger(row.VolumeTraded), "VolumeTraded 应为整数").to.equal(true);
      expect(Number.isInteger(row.VolumeTotal), "VolumeTotal 应为整数").to.equal(true);
    });
  });
}

docs {
  默认 mode=sandbox，读取服务端 ctp.test，沿用集合 Bearer 鉴权。
  包含挂单、已成交和已撤订单；观察 OrderStatus/OrderSubmitStatus，撤单标识从这里复制。
  无记录时返回空数组是合法结果。首次连接会认证、登录并确认结算。
}
