meta {
  name: 查询 CNY 账户资金
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/ctp/fetch_balance?mode=sandbox&currency_id=CNY
  body: none
  auth: inherit
}

params:query {
  mode: sandbox
  currency_id: CNY
}

assert {
  res.status: eq 200
  res.body.mode: eq sandbox
}

tests {
  test("成功响应属于模拟盘，并包含 CTP 请求号与交易日", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.mode).to.equal("sandbox");
    expect(Number.isInteger(body.request_id)).to.equal(true);
    expect(body.trading_day).to.match(/^\d{8}$/);
  });

  test("accounts 为数组，逐项保留详细 CTP 字段；允许空数组", function () {
    const rows = res.getBody().accounts;
    expect(rows).to.be.an("array");
    rows.forEach(function (row) {
      expect(row.CurrencyID).to.be.a("string");
      expect(row).to.have.property("Balance");
      if (row.Balance !== null) expect(row.Balance).to.be.a("number");
      expect(row).to.have.property("Available");
      if (row.Available !== null) expect(row.Available).to.be.a("number");
      expect(row).to.have.property("CurrMargin");
      if (row.CurrMargin !== null) expect(row.CurrMargin).to.be.a("number");
      expect(row).to.have.property("Commission");
      if (row.Commission !== null) expect(row.Commission).to.be.a("number");
    });
  });
}

docs {
  默认 mode=sandbox，读取服务端 ctp.test，沿用集合 Bearer 鉴权。
  检查 Balance、Available、CurrMargin、Commission 等资金字段，金额币种由 CurrencyID 指定。
  无记录时返回空数组是合法结果。白名单内的模式已在启动阶段认证、登录并确认结算。
}
