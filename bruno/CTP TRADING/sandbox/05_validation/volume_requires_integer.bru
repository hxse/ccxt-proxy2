meta {
  name: 非整数手数 → 422 [STATEFUL]
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/ctp/create_limit_order
  body: json
  auth: inherit
}

body:json {
  {
    "mode": "sandbox",
    "exchange_id": "SHFE",
    "instrument_id": "rb2610",
    "side": "buy",
    "offset": "open",
    "volume": 1.5,
    "price": 3500
  }
}

assert {
  res.status: eq 422
}

tests {
  test("在参数校验阶段拒绝 volume，返回字段错误列表", function () {
    expect(res.getStatus()).to.equal(422);
    const issues = res.getBody().detail;
    expect(issues).to.be.an("array").and.not.to.be.empty;
    expect(issues.some(function (issue) {
      return Array.isArray(issue.loc) && issue.loc.includes("volume");
    })).to.equal(true);
  });
}

docs {
  mode=sandbox。此用例故意包含非法参数，预期 HTTP 422，detail 为字段校验错误数组。
  正确实现会在调用 CTP 之前拒绝，不需要 CTP 已登录；仍需本项目 Bearer token。
  保留非法字段用于测试，不要为获得 200 而修正本用例。
}
