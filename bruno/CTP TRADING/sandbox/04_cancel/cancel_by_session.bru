meta {
  name: 按原订单会话标识撤单 [STATEFUL]
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/ctp/cancel_order
  body: json
  auth: inherit
}

body:json {
  {
    "mode": "sandbox",
    "by": "session_order",
    "exchange_id": "SHFE",
    "instrument_id": "rb2610",
    "front_id": 1,
    "session_id": 123,
    "order_ref": "1"
  }
}

assert {
  res.status: eq 200
  res.body.mode: eq sandbox
}

tests {
  test("成功响应属于模拟盘，并包含 CTP 请求号与交易日", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.mode).to.equal("sandbox");
    expect(Number.isInteger(body.request_id)).to.equal(true);
    expect(body.trading_day).to.match(/^\d{8}$/);
  });

  test("收到已撤单回报并保留原始订单标识", function () {
    const order = res.getBody().order;
    expect(order.OrderStatus).to.equal("5");
    ["OrderRef", "OrderSysID", "ExchangeID", "InstrumentID", "StatusMsg"].forEach(function (name) {
      expect(order[name]).to.be.a("string");
    });
    expect(Number.isInteger(order.VolumeTraded)).to.equal(true);
    expect(Number.isInteger(order.VolumeTotal)).to.equal(true);
  });
}

docs {
  mode=sandbox，只撤指定订单剩余的未成交部分。
  先从下单或查询订单响应复制真实订单标识，示例编号不能直接使用。
  必须使用原订单的 FrontID、SessionID、OrderRef；不要用重新登录后的会话编号。
  两种方式二选一测试同一笔订单。200 表示收到 OrderStatus=5，已成交部分不会撤回。
}
