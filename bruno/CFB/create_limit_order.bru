meta {
  name: create_limit_order [STATEFUL]
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/cfb/create_limit_order
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~Idempotency-Key: replace-with-request-key
}

body:json {
  {
    "mode": "sandbox",
    "exchange_id": "SHFE",
    "instrument_id": "rb2610",
    "side": "buy",
    "offset": "open",
    "volume": 1,
    "price": 3500,
    "time_in_force": "GFD",
    "hedge_flag": "speculation",
    "invest_unit_id": ""
  }
}

assert {
  res.status: eq 202
}

docs {
  通过 ccxt-proxy2 的 Bearer 鉴权转发到 CFB；mode 默认 sandbox，必须匹配上游启动环境，否则返回 409；live 不会触发账户切换。
  本请求有交易副作用，请替换合约、价格或订单标识后按需单独执行。可选 Idempotency-Key 默认关闭，启用时由调用方填写。
  上游能力与当前状态决定是否返回 202；不支持的功能可能返回 501。代理原样返回结果，不自动重试。
  202、submitted 和 verification.status=observed 均不代表全部成交。使用响应 order_id 或完整 identity 查询 fetch_orders，再查看订单状态及成交手数；非成功响应也可能含提交事实。
}
