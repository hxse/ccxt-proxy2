meta {
  name: fetch_trading_status
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/cfb/fetch_trading_status?mode=sandbox&exchange_id=SHFE&product_id=rb
  body: none
  auth: inherit
}

params:query {
  mode: sandbox
  exchange_id: SHFE
  product_id: rb
}

assert {
  res.status: eq 200
}

tests {
  test("保留 CFB 原始响应和请求编号", function () {
    const body = res.getBody();
    expect(body.request_id).to.be.a("string");
    expect(body.is_trading).to.be.a("boolean");
    expect(body.source).to.equal("terminal_native");
  });
}

docs {
  通过 ccxt-proxy2 的 Bearer 鉴权转发到服务端配置的 CFB；默认 mode=sandbox，可按上游配置修改为 live。
  合约和品种按实际环境修改；查询 URL 和 params:query 同步修改。详细参数及返回模型从 CFB 自动文档同步到本项目 /docs。
}
