meta {
  name: fetch_positions
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/cfb/fetch_positions?mode=sandbox&exchange_id=SHFE&instrument_id=rb2610
  body: none
  auth: inherit
}

params:query {
  mode: sandbox
  exchange_id: SHFE
  instrument_id: rb2610
}

assert {
  res.status: eq 200
}

tests {
  test("保留 CFB 原始响应和请求编号", function () {
    const body = res.getBody();
    expect(body.request_id).to.be.a("string");
    expect(body.positions).to.be.an("array");
  });
}

docs {
  通过 ccxt-proxy2 的 Bearer 鉴权转发到 CFB；mode 默认 sandbox，必须匹配上游启动环境，否则返回 409；live 不会触发账户切换。
  合约和品种按实际环境修改；查询 URL 和 params:query 同步修改。详细参数及返回模型从 CFB 自动文档同步到本项目 /docs。
}
