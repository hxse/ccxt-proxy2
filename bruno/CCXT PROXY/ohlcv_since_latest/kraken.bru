meta {
  name: kraken
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/ccxt/ohlcv/since-latest
  body: none
  auth: inherit
}

params:query {
  exchange_name: kraken
  market: future
  mode: live
  symbol: BTC/USD:USD
  timeframe: 15m
  since: 1740787200000
  variant: default
  enable_cache: true
  include_last: true
}
