meta {
  name: binance
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/ccxt/fetch_open_orders?exchange_name=binance&market=future&is_live=false&symbol=BTC/USDT:USDT
  body: none
  auth: inherit
}

params:query {
  exchange_name: binance
  market: future
  is_live: false
  symbol: BTC/USDT:USDT
}

assert {
  res.status: eq 200
}
