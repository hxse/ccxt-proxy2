meta {
  name: kraken unknown symbol -> INVALID_PROVIDER_REQUEST
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/ccxt/fetch_ohlcv/latest-limit?exchange_name=kraken&market=future&mode=live&symbol=UNKNOWN/USD:USD&timeframe=15m&limit=1&variant=default&enable_cache=false
  body: none
  auth: inherit
}

params:query {
  exchange_name: kraken
  market: future
  mode: live
  symbol: UNKNOWN/USD:USD
  timeframe: 15m
  limit: 1
  variant: default
  enable_cache: false
}

assert {
  res.status: eq 422
  res.body.detail.code: eq INVALID_PROVIDER_REQUEST
}
