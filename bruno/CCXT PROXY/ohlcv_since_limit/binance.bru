meta {
  name: binance
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/ccxt/ohlcv/since-limit
  body: none
  auth: inherit
}

params:query {
  exchange_name: binance
  market: future
  mode: live
  symbol: BTC/USDT:USDT
  timeframe: 15m
  since: 1740787200000
  limit: 10
  variant: default
  enable_cache: true
  include_last: true
}
