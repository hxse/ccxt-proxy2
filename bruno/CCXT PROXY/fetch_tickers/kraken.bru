meta {
  name: kraken
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/ccxt/fetch_tickers?exchange_name=kraken&market=future&mode=live&symbols=BTC/USD:USD,ETH/USD:USD
  body: json
  auth: inherit
}

params:query {
  mode: live
  market: future
  exchange_name: kraken
  symbols: BTC/USD:USD,ETH/USD:USD
}

assert {
  res.status: eq 200
}
