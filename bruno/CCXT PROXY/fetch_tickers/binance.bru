meta {
  name: binance
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/ccxt/fetch_tickers?exchange_name=binance&market=future&mode=live&symbols=BTC/USDT:USDT,ETH/USDT:USDT
  body: json
  auth: inherit
}

params:query {
  mode: live
  market: future
  exchange_name: binance
  symbols: BTC/USDT:USDT,ETH/USDT:USDT
}

assert {
  res.status: eq 200
}
