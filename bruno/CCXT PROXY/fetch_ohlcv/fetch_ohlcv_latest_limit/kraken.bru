meta {
  name: kraken
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/ccxt/fetch_ohlcv/latest-limit?exchange_name=kraken&market=future&mode=live&symbol=BTC/USD:USD&timeframe=15m&limit=3&variant=default&enable_cache=true
  body: none
  auth: inherit
}

params:query {
  exchange_name: kraken
  market: future
  mode: live
  symbol: BTC/USD:USD
  timeframe: 15m
  limit: 3
  variant: default
  enable_cache: true
}

assert {
  res.status: eq 200
}

docs {
  固定周期查询复用单片段缓存和 since＋limit 分页；最新类只固定一次快照。普通网络末根返回但不新增落盘。
}
