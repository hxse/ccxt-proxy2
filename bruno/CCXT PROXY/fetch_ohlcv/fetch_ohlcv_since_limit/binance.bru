meta {
  name: binance
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/ccxt/fetch_ohlcv/since-limit?exchange_name=binance&market=future&mode=live&symbol=BTC/USDT:USDT&timeframe=15m&since=1740787200000&limit=3&variant=default&enable_cache=true
  body: none
  auth: inherit
}

params:query {
  exchange_name: binance
  market: future
  mode: live
  symbol: BTC/USDT:USDT
  timeframe: 15m
  since: 1740787200000
  limit: 3
  variant: default
  enable_cache: true
}

assert {
  res.status: eq 200
}

docs {
  固定周期查询复用单片段缓存和 since＋limit 分页；最新类只固定一次快照。普通网络末根返回但不新增落盘。
}
