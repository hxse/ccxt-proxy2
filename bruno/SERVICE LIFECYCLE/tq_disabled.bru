meta {
  name: 未启用 tq 时拒绝请求
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/tq/fetch_trading_status?symbol=SHFE.rb2610
  body: none
  auth: inherit
}

params:query {
  symbol: SHFE.rb2610
}

assert {
  res.status: eq 503
  res.body.detail.code: eq SERVICE_NOT_ENABLED
  res.body.detail.service: eq tq
}

docs {
  前提：当前进程启动时的 service_whitelist 没有 tq。建议使用本目录 disabled.example.toml。
  请求必须返回禁用错误，不会临时初始化 SDK 或建立连接；不会下单。
}
