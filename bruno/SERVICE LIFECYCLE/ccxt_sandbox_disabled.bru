meta {
  name: 未启用 ccxt/binance/future/sandbox 时拒绝请求
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/ccxt/fetch_balance?exchange_name=binance&market=future&mode=sandbox
  body: none
  auth: inherit
}

params:query {
  exchange_name: binance
  market: future
  mode: sandbox
}

assert {
  res.status: eq 503
  res.body.detail.code: eq SERVICE_NOT_ENABLED
  res.body.detail.service: eq ccxt/binance/future/sandbox
}

docs {
  前提：当前进程启动时的 service_whitelist 没有 ccxt/binance/future/sandbox。建议使用本目录 disabled.example.toml。
  请求必须返回禁用错误，不会临时初始化 SDK 或建立连接；不会下单。
}
